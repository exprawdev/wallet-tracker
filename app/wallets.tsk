  container: {
    flex: 1,
    backgroundColor: "#080D18",
    padding: 20,
  },
  title: {
    color: "#FFFFFF",
    fontSize: 24,
    fontWeight: "900",
    marginTop: 45,
  },
  subtitle: {
    color: "#8B9BB4",
    fontSize: 12,
    marginTop: 8,
    marginBottom: 25,
  },
