
import React, { useState } from "react";
import {
  View,
  Text,
  TextInput,
  TouchableOpacity,
  ScrollView,
  StyleSheet,
  Alert,
} from "react-native";

type Wallet = {
  id: string;
  name: string;
  address: string;
  network: string;
};

const networks = [
  "Ethereum",
  "BNB Chain",
  "Polygon",
  "Arbitrum",
  "Base",
  "Optimism",
  "Avalanche",
  "Solana",
  "TON",
];

export default function WalletsScreen() {
  const [name, setName] = useState("");
  const [address, setAddress] = useState("");
  const [network, setNetwork] = useState("Ethereum");
  const [wallets, setWallets] = useState<Wallet[]>([]);

  function addWallet() {
    if (!name.trim() || !address.trim()) {
      Alert.alert("Data belum lengkap", "Masukkan nama dan alamat wallet.");
      return;
    }

    const newWallet: Wallet = {
      id: Date.now().toString(),
      name: name.trim(),
      address: address.trim(),
      network,
    };

    setWallets((previous) => [...previous, newWallet]);
    setName("");
    setAddress("");
    Alert.alert("Berhasil", "Wallet ditambahkan ke daftar.");
  }

  function removeWallet(id: string) {
    setWallets((previous) =>
      previous.filter((wallet) => wallet.id !== id)
    );
  }

  return (
    <ScrollView style={styles.container}>
      <Text style={styles.title}>WALLET MANAGER</Text>
      <Text style={styles.subtitle}>
        Tambahkan alamat wallet yang ingin dipantau
      </Text>

      <View style={styles.form}>
        <Text style={styles.label}>NAMA WALLET</Text>
        <TextInput
          style={styles.input}
          placeholder="Contoh: Whale Wallet"
          placeholderTextColor="#75849C"
          value={name}
          onChangeText={setName}
        />

        <Text style={styles.label}>ALAMAT WALLET</Text>
        <TextInput
          style={styles.input}
          placeholder="Masukkan public wallet address"
          placeholderTextColor="#75849C"
          value={address}
          onChangeText={setAddress}
          autoCapitalize="none"
          autoCorrect={false}
        />

        <Text style={styles.label}>PILIH NETWORK</Text>
        <View style={styles.networkList}>
          {networks.map((item) => (
            <TouchableOpacity
              key={item}
              style={[
                styles.networkButton,
                network === item && styles.selectedNetwork,
              ]}
              onPress={() => setNetwork(item)}
            >
              <Text
                style={[
                  styles.networkText,
                  network === item && styles.selectedText,
                ]}
              >
                {item}
              </Text>
            </TouchableOpacity>
          ))}
        </View>

        <TouchableOpacity style={styles.addButton} onPress={addWallet}>
          <Text style={styles.addText}>+ ADD WALLET</Text>
        </TouchableOpacity>
      </View>

      <View style={styles.listHeader}>
        <Text style={styles.sectionTitle}>MY TRACKED WALLETS</Text>
        <Text style={styles.count}>{wallets.length} WALLETS</Text>
      </View>

      {wallets.length === 0 ? (
        <View style={styles.empty}>
          <Text style={styles.emptyText}>Belum ada wallet</Text>
          <Text style={styles.muted}>
            Tambahkan alamat wallet untuk memulai.
          </Text>
        </View>
      ) : (
        wallets.map((wallet) => (
          <View style={styles.walletCard} key={wallet.id}>
            <Text style={styles.walletName}>{wallet.name}</Text>
            <Text style={styles.networkName}>{wallet.network}</Text>
            <Text selectable style={styles.address}>
              {wallet.address}
            </Text>
            <TouchableOpacity
              style={styles.removeButton}
              onPress={() => removeWallet(wallet.id)}
            >
              <Text style={styles.removeText}>REMOVE WALLET</Text>
            </TouchableOpacity>
          </View>
        ))
      )}

      <Text style={styles.notice}>
        Catatan: fitur ini menyimpan data sementara selama aplikasi berjalan.
        Penyimpanan permanen dan pemantauan blockchain akan ditambahkan
        pada tahap integrasi berikutnya.
      </Text>
    </ScrollView>
  );
}

